{
  "name": "radar-croacia",
  "version": "0.1.0",
  "private": true,
  "description": "Oportunidades oficiales de Croacia para descendientes de croatas, en español.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "http-server site -p 8080 -c-1",
    "validate": "node scripts/validate-data.mjs",
    "lint": "eslint . && prettier --check . && tsc -p .",
    "format": "prettier --write .",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test": "npm run validate && npm run test:unit && npm run test:e2e",
    "check": "npm run lint && npm test",
    "monitor": "node scripts/monitor.mjs",
    "policy": "node scripts/build-policy.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "http-server": "14.1.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fast-xml-parser": "4.5.0"
  }
}
