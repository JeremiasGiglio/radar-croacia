{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Radar Croacia: datos publicados",
  "type": "object",
  "required": ["version", "verified_at", "note", "categories", "opportunities"],
  "properties": {
    "version": { "type": "string", "format": "date" },
    "verified_at": { "type": "string", "format": "date" },
    "note": { "type": "string", "minLength": 10 },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["n", "c"],
        "properties": { "n": { "type": "string" }, "c": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } }
      }
    },
    "opportunities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "cat", "t", "who", "pts", "amount", "what", "el", "src", "verified_at"],
        "anyOf": [{ "required": ["deadline"] }, { "required": ["next"] }],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "cat": { "enum": ["beca", "emp", "res", "loc", "proy"] },
          "t": { "type": "string", "minLength": 5 },
          "t_hr": { "type": "string" },
          "who": { "type": "string", "minLength": 2 },
          "pts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": [
                { "type": "number", "minimum": 13, "maximum": 19.5 },
                { "type": "number", "minimum": 42.3, "maximum": 46.6 }
              ]
            }
          },
          "deadline": { "type": "string", "format": "date-time" },
          "next": { "type": "string", "minLength": 3 },
          "amount": { "type": "string", "minLength": 2 },
          "what": { "type": "string", "minLength": 20 },
          "el": {
            "type": "object",
            "required": ["ar", "cit", "res"],
            "additionalProperties": false,
            "patternProperties": {
              "^(ar|cit|res)$": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": [{ "enum": ["ok", "cond", "no"] }, { "type": "string", "minLength": 5 }]
              }
            }
          },
          "src": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [{ "type": "string" }, { "type": "string", "pattern": "^https://" }]
          },
          "verified_at": { "type": "string", "format": "date" },
          "verified_by": { "type": "string" },
          "ai_generated": { "type": "boolean" },
          "flag": { "type": "string" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "t", "where", "note", "src"],
        "properties": {
          "src": { "type": "array", "items": [{ "type": "string" }, { "type": "string", "pattern": "^https://" }] }
        }
      }
    }
  }
}
